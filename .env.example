# Copy this file to .env and fill in real values.
# Never commit the actual .env file — it's already in .gitignore.

# ---- Database (MySQL) ----
DB_HOST=10.246.231.52
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-real-password-here
DB_NAME=placement_portal_db
DB_CHARSET=utf8mb4

# ---- App ----
SECRET_KEY=change-this-to-something-random
DEBUG=True
PORT=5000

# ---- Email (Gmail SMTP) ----
# EMAIL_ADDRESS = the dummy Gmail address
# EMAIL_APP_PASSWORD = 16-character App Password (NOT your normal Gmail
# password). Generate at https://myaccount.google.com/apppasswords
# after enabling 2-Step Verification on that Gmail account.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# ---- Google Sign-In ----
# From Google Cloud Console -> APIs & Services -> Credentials.
# See config/google_auth.py for full step-by-step setup instructions.
GOOGLE_CLIENT_ID=

# Copy this file to .env and fill in real values.
# Never commit the actual .env file — it's already in .gitignore.

# ---- Database (MySQL) ----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

# ---- App ----
SECRET_KEY=change-this-to-something-random
DEBUG=True
PORT=5000
FRONTEND_URL=http://localhost:5173

# ---- Email (Resend HTTP API) ----
# Sign up free at resend.com -> API Keys -> Create API Key
# For quick testing, RESEND_SENDER_EMAIL can stay as onboarding@resend.dev
# (Resend's shared test domain) — BUT this only delivers to the email
# address your Resend account itself is registered with, until you
# verify your own domain under Domains in the Resend dashboard.
RESEND_API_KEY=
RESEND_SENDER_EMAIL=onboarding@resend.dev

# ---- Google Sign-In (Student only) ----
GOOGLE_CLIENT_ID=
